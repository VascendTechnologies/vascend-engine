<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>VascendEngine.App</StartupObject>
    <AssemblyName>VascendEngine</AssemblyName>
    <RootNamespace>VascendEngine</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>engine.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="engine.png" />
    <Resource Include="ide.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <!-- grafica a pixel, funzioni native e stile condiviso vengono dalla barra -->
  <ItemGroup>
    <Compile Include="..\..\barra-vascend\src\Pixel.cs" Link="Barra\Pixel.cs" />
    <Compile Include="..\..\barra-vascend\src\Native.cs" Link="Barra\Native.cs" />
    <Compile Include="..\..\barra-vascend\src\Stile.cs" Link="Barra\Stile.cs" />
    <Compile Include="..\..\barra-vascend\src\WidgetAspetto.cs" Link="Barra\WidgetAspetto.cs" />
    <Compile Include="..\..\barra-vascend\src\ExtensionState.cs" Link="Barra\ExtensionState.cs" />
  </ItemGroup>
</Project>
